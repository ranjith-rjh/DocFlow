[Unit]
Description=DocFlow AI - MS3 extraction et insertion
Documentation=file:///opt/docflow/app
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=docflow
Group=docflow
WorkingDirectory=/opt/docflow
EnvironmentFile=/etc/docflow/ms3.env
ExecStart=/opt/docflow/venv/bin/python -m docflow.extraction.service
# Redémarre seul après une panne (et réessaie tant que RabbitMQ est absent).
Restart=always
RestartSec=3

# Durcissement : MS3 n'a besoin que de lire son code et de parler au réseau.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
